generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
provider = "mysql"
url      = env("DATABASE_URL")
}

///////////////////////
// USER MANAGEMENT
///////////////////////

model Account {
id                String  @id @default(cuid())
userId            String
type              String
provider          String
providerAccountId String
refresh_token     String? @db.Text
access_token      String? @db.Text
expires_at        Int?
token_type        String?
scope             String?
id_token          String? @db.Text
session_state     String?
user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

@@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires     DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?  
}

model User {
id            String         @id @default(cuid())
name          String?
email         String?       @unique
emailVerified DateTime?
image         String?
createdAt     DateTime      @default(now())
updatedAt     DateTime      @updatedAt
role          UserRole      @default(USER)
accounts      Account[]
sessions      Session[]
documents     Document[]
applications  Application[]
gnr           Int?
bnr           Int?
fnr          Int?
snr          Int?
address       String?
postalCode    String?
postalArea    String?
phone         String?


}

model VerificationRequest {
id         String   @id @default(cuid())
identifier String
token      String   @unique
expires    DateTime
createdAt  DateTime @default(now())
updatedAt  DateTime @updatedAt

@@unique([identifier, token])
}

enum UserRole {
USER
CASE_WORKER
}



///////////////////////
// APPLICATION & DOCUMENTS
///////////////////////


model Application {
applicationID  Int               @id @unique(map: "applicationID_UNIQUE") @default(autoincrement())
applicationType ApplicationType
userID         String
user           User              @relation(fields: [userID], references: [id])
submissionDate DateTime          @db.DateTime(0)
updatedDate    DateTime          @db.DateTime(0)
status         ApplicationStatus @default(Pabegynt)
documents      Document[]
responses      Response[]
Letters        Letter[]
}

enum ApplicationStatus {
Pabegynt
Ferdig
Sendt
}

enum ApplicationType {
  bygge_tilbygg_mindre_enn_50kvm
  rive_tilbygg_mindre_enn_50kvm
  bygge_frittliggende_bygning_mindre_70kvm
  rive_frittliggende_bygning_mindre_70kvm
  bruksendring
  bygge_vanlige_driftsbygninger_for_landbruket_mindre_1000m2
  endre_vanlige_driftsbygninger_for_landbruket_mindre_1000m2
  rive_vanlige_driftsbygninger_for_landbruket_mindre_1000m2
  melding_om_bygning_unntatt_soknadsplikt
  melding_om_tilbygg_unntatt_soknadsplikt

}

model requiredField {
  requiredFiledID Int @id @default(autoincrement())
  applicationType ApplicationType
  fieldName       String
  fieldDescription String
}
model Letter {
letterID Int @id @default(autoincrement())
application        Application @relation(fields: [applicationID], references: [applicationID])
applicationID      Int
recipientName      String
createdAt         DateTime @default(now())
fields           LetterField[]



}
model LetterField {
letterFieldID Int @id @default(autoincrement())
letter         Letter @relation(fields: [letterID], references: [letterID])
letterID       Int
filedName      String
fieldValue     String
source         String
createdAt      DateTime @default(now())
updatedAt      DateTime @updatedAt


}
model application_field {
  application_fieldID Int @id @default(autoincrement())
  fieldName           String @db.Text 
  fieltdValue         String @db.Text 
  createdDate         DateTime          @db.DateTime(0)
  updatedDate         DateTime          @db.DateTime(0)
}

///////////////////////
// DOCUMENT STORAGE
///////////////////////

model Document {
  documentID    Int            @id @default(autoincrement())
  fileName      String
  document      Bytes
  applicationID Int?
  application   Application?   @relation(fields: [applicationID], references: [applicationID])
  modelID       Int           
  model         Model       @relation(fields: [modelID], references: [modelID])
  userID        String
  user          User          @relation(fields: [userID], references: [id])
  createdAt     DateTime      @default(now()) 
  validations   DocumentValidation[] 
}




///////////////////////
// AI MODEL RESPONSE HANDLING
///////////////////////

model Response {
responseID    Int          @id @unique(map: "responseID_UNIQUE") @default(autoincrement())
response      String
modelID       Int
model         Model        @relation(fields: [modelID], references: [modelID])
applicationID Int
application   Application  @relation(fields: [applicationID], references: [applicationID])
errors        ModelError[]
}

model ModelError {
errorID    Int      @id @unique(map: "errorID_UNIQUE") @default(autoincrement())
error      String
modelID    Int
model      Model    @relation(fields: [modelID], references: [modelID])
responseID Int
response   Response @relation(fields: [responseID], references: [responseID])
}

model Model {
modelID     Int          @id @unique(map: "modelID_UNIQUE") @default(autoincrement())
modelName   String       @unique
modelErrors ModelError[]
responses   Response[]
  documents   Document[] 
  
}

model DocumentValidation {
  id          Int      @id @default(autoincrement())
  documentID  Int
  document    Document @relation(fields: [documentID], references: [documentID], onDelete: Cascade)
  drawingType String
  createdAt   DateTime @default(now())

  @@unique([documentID, drawingType])
}