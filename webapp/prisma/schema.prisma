generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x","debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  accessToken  String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  role          UserRole      @default(USER)
  address       String?
  bnr           Int?
  fnr           Int?
  gnr           Int?
  phone         String?
  postalArea    String?
  postalCode    String?
  snr           Int?
  image         String?
  accounts      Account[]
  applications  Application[]
  documents     Document[]
  sessions      Session[]
}

model VerificationRequest {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}

model Application {
  applicationID      Int                 @id @unique(map: "applicationID_UNIQUE") @default(autoincrement())
  userID             String
  submissionDate     DateTime            @db.DateTime(0)
  status             ApplicationStatus   @default(Pabegynt)
  applicationType    ApplicationType
  subTypeId        String?
  updatedDate        DateTime            @db.DateTime(0)
  user               User                @relation(fields: [userID], references: [id])
  documents          Document[]
  Letters            Letter[]
  responses          Response[]
  application_fields application_field[]

  @@index([userID], map: "Application_userID_fkey")
}

model requiredField {
  requiredFiledID  Int             @id @default(autoincrement())
  applicationType  ApplicationType
  fieldName        String
  fieldDescription String
}

model Letter {
  letterID      Int           @id @default(autoincrement())
  applicationID Int
  recipientName String
  createdAt     DateTime      @default(now())
  application   Application   @relation(fields: [applicationID], references: [applicationID])
  fields        LetterField[]

  @@index([applicationID], map: "Letter_applicationID_fkey")
}

model LetterField {
  letterFieldID Int      @id @default(autoincrement())
  letterID      Int
  filedName     String
  fieldValue    String
  source        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  letter        Letter   @relation(fields: [letterID], references: [letterID])

  @@index([letterID], map: "LetterField_letterID_fkey")
}

model application_field {
  application_fieldID Int         @id @default(autoincrement())
  fieldName           String      @db.Text
  createdDate         DateTime    @db.DateTime(0)
  updatedDate         DateTime    @db.DateTime(0)
  applicationID       Int
  fieldValue          String      @db.Text
  application         Application @relation(fields: [applicationID], references: [applicationID])

  @@index([applicationID], map: "application_field_applicationID_fkey")
}

model Document {
  documentID    Int                  @id @default(autoincrement())
  fileName      String
  document      Bytes
  applicationID Int?
  modelID       Int
  userID        String
  createdAt     DateTime             @default(now())
  application   Application?         @relation(fields: [applicationID], references: [applicationID])
  model         Model                @relation(fields: [modelID], references: [modelID])
  user          User                 @relation(fields: [userID], references: [id])
  validations   DocumentValidation[]

  @@index([applicationID], map: "Document_applicationID_fkey")
  @@index([modelID], map: "Document_modelID_fkey")
  @@index([userID], map: "Document_userID_fkey")
}

model Response {
  responseID    Int          @id @unique(map: "responseID_UNIQUE") @default(autoincrement())
  response      String
  modelID       Int
  applicationID Int
  errors        ModelError[]
  application   Application  @relation(fields: [applicationID], references: [applicationID])
  model         Model        @relation(fields: [modelID], references: [modelID])

  @@index([applicationID], map: "Response_applicationID_fkey")
  @@index([modelID], map: "Response_modelID_fkey")
}

model ModelError {
  errorID    Int      @id @unique(map: "errorID_UNIQUE") @default(autoincrement())
  error      String
  modelID    Int
  responseID Int
  model      Model    @relation(fields: [modelID], references: [modelID])
  response   Response @relation(fields: [responseID], references: [responseID])

  @@index([modelID], map: "ModelError_modelID_fkey")
  @@index([responseID], map: "ModelError_responseID_fkey")
}

model Model {
  modelID     Int          @id @unique(map: "modelID_UNIQUE") @default(autoincrement())
  modelName   String       @unique
  documents   Document[]
  modelErrors ModelError[]
  responses   Response[]
}

model DocumentValidation {
  id          Int      @id @default(autoincrement())
  documentID  Int
  drawingType String
  createdAt   DateTime @default(now())
  document    Document @relation(fields: [documentID], references: [documentID], onDelete: Cascade)

  @@unique([documentID, drawingType])
}



enum UserRole {
  USER
  CASE_WORKER
}

enum ApplicationStatus {
  Pabegynt
  Sendt
  Motatt
  Under_Behandling
  Horing
  Vedtakfattes
  Endelig_Avgjorelse
  Ferdig_behandlet 
}

enum ApplicationType {
  sma_byggeprosjekter
  bruksendring
  pending

  
}


